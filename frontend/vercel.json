{
  "functions": {
    "api/sitemap.js": {
      "includeFiles": "public/sitemap-static.xml"
    }
  },
  "redirects": [
    {
      "source": "/fleet",
      "destination": "/luxury-fleet",
      "permanent": true
    },
    {
      "source": "/Premier",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/premier",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/capstone-limo-service",
      "destination": "/cape-st-claire-limo-service",
      "permanent": true
    },
    {
      "source": "/snopesville-limo-service",
      "destination": "/sykesville-limo-service",
      "permanent": true
    },
    {
      "source": "/images/:name((?!bmw-7series)[^/]+)\\.(jpg|jpeg)",
      "destination": "/images/:name.webp",
      "permanent": true
    },
    {
      "source": "/images/gallery/:name([^/]+)\\.(jpg|jpeg)",
      "destination": "/images/gallery/:name.webp",
      "permanent": true
    },
    {
      "source": "/images/stock/:name([^/]+)\\.(jpg|jpeg)",
      "destination": "/images/stock/:name.webp",
      "permanent": true
    },
    {
      "source": "/fleet/:name([^/]+)\\.(jpg|jpeg)",
      "destination": "/fleet/:name.webp",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/booking",
      "destination": "/booking/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/shell.html"
    }
  ]
}
